+#pragma once
+
+#include <pointcloud_topo/graph.h>
+#include <ros/ros.h>
+#include <std_msgs/String.h>
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+namespace fast_planner {
+
+// Passive collector: never mutates graph/candidates or chooses an action.
+// A complete, pointer-free JSON snapshot is copied on the planner thread.
+class DecisionRecorder {
+public:
+  explicit DecisionRecorder(ros::NodeHandle &nh);
+  ~DecisionRecorder();
+  DecisionRecorder(const DecisionRecorder &) = delete;
+  DecisionRecorder &operator=(const DecisionRecorder &) = delete;
+
+  void record(const TopoGraph::Ptr &graph, const Eigen::Vector3d &position,
+              const Eigen::Vector3d &velocity, double yaw,
+              const std::vector<TopoNode::Ptr> &candidates,
+              const std::vector<double> &odom_costs,
+              const Eigen::Vector3f &anchor, bool uses_previous_goal,
+              const Eigen::MatrixXd &cost_matrix,
+              const std::vector<int> &expert_route, const char *result);
+
+  static std::string snapshot(const TopoGraph::Ptr &graph, const Eigen::Vector3d &position,
+              const Eigen::Vector3d &velocity, double yaw,
+              const std::vector<TopoNode::Ptr> &candidates,
+              const std::vector<double> &odom_costs, const Eigen::Vector3f &anchor,
+              bool uses_previous_goal, const Eigen::MatrixXd &cost_matrix,
+              const std::vector<int> &expert_route, const char *result, size_t decision_id,
+              const std::vector<double>& gains = {}, const Eigen::MatrixXi& reachable = Eigen::MatrixXi());
+  void append(std::string data);
+
+private:
+  void fail(const std::string &message);
+  void writeLoop();
+  int fd_ = -1;
+  std::string filename_;
+  ros::Publisher error_pub_;
+  std::thread worker_;
+  std::mutex mutex_;
+  std::condition_variable ready_;
+  std::deque<std::string> pending_;
+  bool closing_ = false;
+  std::atomic<bool> failed_{false};
+  size_t max_pending_ = 64, sequence_ = 0, written_ = 0;
+};
+} // namespace fast_planner
diff --git a/src/global_planner/exploration_manager/include/epic_planner/observed_volume.h b/src/global_planner/exploration_manager/include/epic_planner/observed_volume.h
new file mode 100644
index 0000000..8370770
--- /dev/null
+++ b/src/global_planner/exploration_manager/include/epic_planner/observed_volume.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <lidar_map/lidar_map.h>
+#include <unordered_set>
+#include <array>
+#include <cmath>
+
+namespace fast_planner {
+// Observed-data-only, coarse unknown-volume estimate. Never reads the simulator map.
+// 1 m voxels, deterministic subsampling of measured rays, and 12 m candidate rays.
+class ObservedVolume {
+  struct Hash {
+    size_t operator()(const std::array<int,3>& p) const {
+      return size_t(p[0])*73856093u ^ size_t(p[1])*19349663u ^ size_t(p[2])*83492791u;
+    }
+  };
+  using Cell=std::array<int,3>;
+  std::unordered_set<Cell,Hash> seen_, occupied_;
+  Cell key(const Eigen::Vector3f& p) const {
+    return {{int(std::floor(p.x())),int(std::floor(p.y())),int(std::floor(p.z()))}};
+  }
+public:
+  void update(const LIOInterface::Ptr& map) {
+    const auto& cloud=map->ld_->lidar_cloud_;
+    const auto origin=map->ld_->lidar_pose_;
+    // Endpoints are world coordinates in the map interface.
+    for (const auto& p:cloud.points) {
+      Eigen::Vector3f hit(p.x,p.y,p.z);
+      if (hit.allFinite()) occupied_.insert(key(hit));
+    }
+    size_t stride=std::max<size_t>(1,cloud.size()/1024);
+    for (size_t i=0;i<cloud.size();i+=stride) {
+      Eigen::Vector3f hit(cloud[i].x,cloud[i].y,cloud[i].z);
+      if (!hit.allFinite()) continue;
+      Eigen::Vector3f delta=hit-origin; float length=delta.norm();
+      if (length<.01f) continue;
+      delta/=length;
+      for (float r=0;r<std::min(length,18.f);r+=.5f) seen_.insert(key(origin+r*delta));
+    }
+  }
+  double gain(const Eigen::Vector3f& position,const LIOInterface::Ptr& map) const {
+    std::unordered_set<Cell,Hash> unknown;
+    for(int az=0;az<36;++az) for(int el=-3;el<=3;++el) {
+      double yaw=az*2*M_PI/36, pitch=el*M_PI/9;
+      Eigen::Vector3f dir(std::cos(pitch)*std::cos(yaw),std::cos(pitch)*std::sin(yaw),std::sin(pitch));
+      for(float r=.5f;r<=12.f;r+=.5f) {
+        Eigen::Vector3f p=position+r*dir;
+        if(!map->IsInBox(p)) break;
+        Cell cell=key(p);
+        if(occupied_.count(cell)) break;
+        if(!seen_.count(cell)) unknown.insert(cell);
+      }
+    }
+    return double(unknown.size()); // volume in m^3 (each unique cell is 1 m^3)
+  }
+};
+}
