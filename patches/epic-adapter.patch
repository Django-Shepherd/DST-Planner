diff --git a/src/global_planner/exploration_manager/src/decision_recorder.cpp b/src/global_planner/exploration_manager/src/decision_recorder.cpp
new file mode 100644
index 0000000..92cf9d8
--- /dev/null
+++ b/src/global_planner/exploration_manager/src/decision_recorder.cpp
@@ -0,0 +1,194 @@
+#include <epic_planner/decision_recorder.h>
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstring>
+#include <fcntl.h>
+#include <fstream>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <unordered_map>
+#include <unistd.h>
+
+namespace fast_planner {
+namespace {
+void number(std::ostream &out, double x) {
+  if (std::isfinite(x)) out << x; else out << "null";
+}
+template <typename V> void xyz(std::ostream &out, const V &v) {
+  out << '['; number(out, v.x()); out << ','; number(out, v.y());
+  out << ','; number(out, v.z()); out << ']';
+}
+}
+
+DecisionRecorder::DecisionRecorder(ros::NodeHandle &nh) {
+  error_pub_ = nh.advertise<std_msgs::String>("/dst_collection/error", 1, true);
+  nh.param<std::string>("collection/output_file", filename_, "");
+  int limit = 64;
+  nh.param("collection/max_pending", limit, 64);
+  max_pending_ = static_cast<size_t>(std::max(1, limit));
+  fd_ = ::open(filename_.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+  if (fd_ < 0) { fail("Cannot create new decision file: " + std::string(std::strerror(errno))); return; }
+  worker_ = std::thread(&DecisionRecorder::writeLoop, this);
+}
+
+void DecisionRecorder::fail(const std::string &message) {
+  failed_ = true;
+  ROS_ERROR_STREAM("DST collection failed: " << message);
+  std_msgs::String msg; msg.data = message; error_pub_.publish(msg);
+}
+
+DecisionRecorder::~DecisionRecorder() {
+  { std::lock_guard<std::mutex> lock(mutex_); closing_ = true; }
+  ready_.notify_all();
+  if (worker_.joinable()) worker_.join();
+  if (fd_ >= 0) {
+    if (::fsync(fd_) != 0) fail("Cannot sync decision file");
+    ::close(fd_);
+    std::ofstream status(filename_ + ".status.json");
+    status << "{\"schema_version\":1,\"enqueued\":" << sequence_
+           << ",\"written\":" << written_ << ",\"failed\":"
+           << (failed_ ? "true" : "false") << "}\n";
+    status.close();
+    if (!status) fail("Cannot write decision completion status");
+  }
+}
+
+void DecisionRecorder::writeLoop() {
+  while (true) {
+    std::string data;
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      ready_.wait(lock, [&] { return closing_ || !pending_.empty(); });
+      if (pending_.empty() && closing_) break;
+      data = std::move(pending_.front()); pending_.pop_front();
+    }
+    size_t offset = 0;
+    while (offset < data.size()) {
+      const ssize_t n = ::write(fd_, data.data() + offset, data.size() - offset);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) { fail("Decision write failed: " + std::string(std::strerror(errno))); return; }
+      offset += static_cast<size_t>(n);
+    }
+    ++written_;
+  }
+}
+
+void DecisionRecorder::record(const TopoGraph::Ptr &graph,
+    const Eigen::Vector3d &position, const Eigen::Vector3d &velocity, double yaw,
+    const std::vector<TopoNode::Ptr> &candidates,
+    const std::vector<double> &odom_costs, const Eigen::Vector3f &anchor,
+    bool uses_previous_goal, const Eigen::MatrixXd &cost_matrix,
+    const std::vector<int> &expert_route, const char *result) {
+  append(snapshot(graph, position, velocity, yaw, candidates, odom_costs, anchor, uses_previous_goal, cost_matrix, expert_route, result, sequence_));
+}
+
+
+std::string DecisionRecorder::snapshot(const TopoGraph::Ptr &graph,
+    const Eigen::Vector3d &position, const Eigen::Vector3d &velocity, double yaw,
+    const std::vector<TopoNode::Ptr> &candidates,
+    const std::vector<double> &odom_costs, const Eigen::Vector3f &anchor,
+    bool uses_previous_goal, const Eigen::MatrixXd &cost_matrix,
+    const std::vector<int> &expert_route, const char *result, size_t decision_id, const std::vector<double>& gains, const Eigen::MatrixXi& reachable) {
+
+  const auto started = ros::WallTime::now();
+  std::vector<TopoNode::Ptr> nodes;
+  std::unordered_map<TopoNode *, size_t> ids;
+  auto add = [&](const TopoNode::Ptr &n) {
+    if (n && ids.emplace(n.get(), nodes.size()).second) nodes.push_back(n);
+  };
+  add(graph->odom_node_);
+  for (const auto &region : graph->regions_arr_)
+    if (region) for (const auto &n : region->topo_nodes_) add(n);
+  for (const auto &region : graph->toponodes_update_region_arr_)
+    if (region) for (const auto &n : region->topo_nodes_) add(n);
+  for (const auto &entry : graph->reg_map_idx2ptr_)
+    if (entry.second) for (const auto &n : entry.second->topo_nodes_) add(n);
+  for (const auto &n : graph->history_odom_nodes_) add(n);
+  for (const auto &n : candidates) add(n);
+  // Include neighbor closure so every exported edge endpoint has an ID.
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    auto n = nodes[i];
+    for (const auto &neighbor : n->neighbors_) add(neighbor);
+  }
+  std::stable_sort(nodes.begin(), nodes.end(), [](const TopoNode::Ptr &a, const TopoNode::Ptr &b) {
+    for (int axis = 0; axis < 3; ++axis)
+      if (a->center_[axis] != b->center_[axis]) return a->center_[axis] < b->center_[axis];
+    return a->is_history_odom_node_ < b->is_history_odom_node_;
+  });
+  ids.clear();
+  for (size_t i = 0; i < nodes.size(); ++i) ids[nodes[i].get()] = i;
+  std::ostringstream out; out.imbue(std::locale::classic()); out << std::setprecision(9);
+  out << "{\"schema_version\":1,\"decision_id\":" << decision_id
+      << ",\"stamp\":" << std::setprecision(17) << ros::Time::now().toSec()
+      << std::setprecision(9) << ",\"frame_id\":\"world\",\"result\":\"" << result
+      << "\",\"position\":"; xyz(out, position);
+  out << ",\"velocity\":"; xyz(out, velocity);
+  out << ",\"yaw\":"; number(out, yaw);
+  out << ",\"planning_anchor\":"; xyz(out, anchor);
+  out << ",\"uses_previous_goal\":" << (uses_previous_goal ? "true" : "false");
+  out << ",\"current_node_id\":" << ids.at(graph->odom_node_.get()) << ",\"nodes\":[";
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    if (i) out << ',';
+    auto n = nodes[i];
+    out << "{\"id\":" << i << ",\"position\":"; xyz(out, n->center_);
+    out << ",\"is_current\":" << (n == graph->odom_node_ ? "true" : "false")
+        << ",\"is_viewpoint\":" << (n->is_viewpoint_ ? "true" : "false")
+        << ",\"is_history\":" << (n->is_history_odom_node_ ? "true" : "false") << '}';
+  }
+  out << "],\"edges\":[";
+  bool first = true;
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    auto n = nodes[i]; std::vector<size_t> neighbors;
+    for (const auto &v : n->neighbors_) if (v) neighbors.push_back(ids.at(v.get()));
+    std::sort(neighbors.begin(), neighbors.end());
+    for (size_t j : neighbors) {
+      if (!first) out << ','; first = false;
+      out << "[" << i << ',' << j << ',';
+      const auto weight = n->weight_.find(nodes[j]);
+      if (weight == n->weight_.end()) out << "null"; else number(out, weight->second);
+      out << ']';
+    }
+  }
+  out << "],\"candidates\":[";
+  for (size_t i = 0; i < candidates.size(); ++i) {
+    if (i) out << ',';
+    out << "{\"id\":" << i << ",\"node_id\":" << ids.at(candidates[i].get()) << ",\"position\":";
+    xyz(out, candidates[i]->center_); out << ",\"yaw\":"; number(out, candidates[i]->yaw_);
+    out << ",\"odom_cost\":";
+    if (i < odom_costs.size()) number(out, odom_costs[i]); else out << "null";
+    out << '}';
+  }
+  out << "],\"matrix_dimension\":" << cost_matrix.rows() << ",\"cost_matrix\":[";
+  for (int i = 0; i < cost_matrix.rows(); ++i)
+    for (int j = 0; j < cost_matrix.cols(); ++j) {
+      if (i || j) out << ','; number(out, cost_matrix(i,j));
+    }
+  out << "],\"expert_route\":[";
+  for (size_t i = 0; i < expert_route.size(); ++i) { if (i) out << ','; out << expert_route[i]; }
+  out << "],\"selected_candidate_id\":";
+  if (expert_route.size() >= 2) out << expert_route[1] - 1; else out << "null";
+  out << ",\"feature_version\":" << (gains.size()==candidates.size() ? 2 : 1)
+      << ",\"graph_version\":" << decision_id
+      << ",\"gain_definition\":\"observed_voxel_raycast_v1\",\"information_gain_m3\":[";
+  for (size_t i=0;i<gains.size();++i) { if(i) out << ','; number(out,gains[i]); }
+  out << "],\"reachability_dimension\":" << reachable.rows() << ",\"reachable\":[";
+  for(int i=0;i<reachable.rows();++i) for(int j=0;j<reachable.cols();++j) {
+    if(i||j) out << ','; out << reachable(i,j);
+  }
+  out << "],\"capture_ms\":" << (ros::WallTime::now() - started).toSec() * 1000. << "}\n";
+  return out.str();
+}
+
+void DecisionRecorder::append(std::string data) {
+  if(failed_) return;
+  if (data.size() > 64 * 1024 * 1024) { fail("Snapshot exceeds 64 MiB"); return; }
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (pending_.size() >= max_pending_) { fail("Decision queue overflow"); return; }
+    pending_.push_back(std::move(data)); ++sequence_;
+  }
+  ready_.notify_one();
+}
+} // namespace fast_planner
diff --git a/src/global_planner/exploration_manager/src/policy_client.cpp b/src/global_planner/exploration_manager/src/policy_client.cpp
new file mode 100644
index 0000000..114d7c2
--- /dev/null
+++ b/src/global_planner/exploration_manager/src/policy_client.cpp
@@ -0,0 +1,66 @@
+#include <epic_planner/policy_client.h>
+#include <boost/property_tree/json_parser.hpp>
+#include <boost/property_tree/ptree.hpp>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <poll.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <chrono>
+#include <cstring>
+#include <sstream>
+#include <set>
+#include <stdexcept>
+
+namespace fast_planner {
+std::vector<int> requestPolicy(const std::string& path,const std::string& json,
+                              size_t decision_id,const Eigen::MatrixXi& reachable,int timeout_ms) {
+  struct FD {int value; ~FD(){if(value>=0)::close(value);}} fd{::socket(AF_UNIX,SOCK_STREAM|SOCK_CLOEXEC|SOCK_NONBLOCK,0)};
+  if(fd.value<0)throw std::runtime_error("policy socket creation failed");
+  sockaddr_un addr{};addr.sun_family=AF_UNIX;
+  if(path.size()>=sizeof(addr.sun_path))throw std::runtime_error("policy socket path too long");
+  std::strcpy(addr.sun_path,path.c_str());
+  auto deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(timeout_ms);
+  auto ready=[&](short events){
+    while(true) {
+      auto remaining=std::chrono::duration_cast<std::chrono::milliseconds>(deadline-std::chrono::steady_clock::now()).count();
+      if(remaining<=0)throw std::runtime_error("policy timeout");
+      pollfd p{fd.value,events,0};int result=poll(&p,1,int(remaining));
+      if(result<0 && errno==EINTR)continue;
+      if(result<=0 || !(p.revents&events))throw std::runtime_error("policy unavailable/timeout");
+      return;
+    }
+  };
+  if(::connect(fd.value,reinterpret_cast<sockaddr*>(&addr),sizeof(addr))<0) {
+    if(errno!=EINPROGRESS && errno!=EAGAIN)throw std::runtime_error("policy connect failed");
+    ready(POLLOUT);int error=0;socklen_t len=sizeof(error);getsockopt(fd.value,SOL_SOCKET,SO_ERROR,&error,&len);
+    if(error)throw std::runtime_error("policy connect failed");
+  }
+  size_t sent=0;
+  while(sent<json.size()) {
+    ready(POLLOUT);ssize_t n=::send(fd.value,json.data()+sent,json.size()-sent,MSG_NOSIGNAL);
+    if(n<0 && (errno==EINTR || errno==EAGAIN))continue;
+    if(n<=0)throw std::runtime_error("policy send failed");sent+=size_t(n);
+  }
+  std::string response;
+  while(response.find('\n')==std::string::npos) {
+    ready(POLLIN);char bytes[4096];ssize_t n=::recv(fd.value,bytes,sizeof(bytes),0);
+    if(n<0 && (errno==EINTR || errno==EAGAIN))continue;
+    if(n<=0)throw std::runtime_error("policy response incomplete");response.append(bytes,size_t(n));
+    if(response.size()>65536)throw std::runtime_error("policy response oversized");
+  }
+  boost::property_tree::ptree tree;std::istringstream in(response);boost::property_tree::read_json(in,tree);
+  if(!tree.get<bool>("ok",false))throw std::runtime_error("policy model error");
+  if(tree.get<size_t>("request_id")!=decision_id || tree.get<size_t>("graph_version")!=decision_id)
+    throw std::runtime_error("stale policy response");
+  std::vector<int> route{0};std::set<int> used;
+  for(const auto& item:tree.get_child("route")) {
+    int v=item.second.get_value<int>()+1;
+    if(v<1 || v>=reachable.rows() || !used.insert(v).second || !reachable(route.back(),v))
+      throw std::runtime_error("invalid policy route");
+    route.push_back(v);
+  }
+  if(route.size()<2 || route.size()>6)throw std::runtime_error("invalid policy horizon");
+  return route;
+}
+}
